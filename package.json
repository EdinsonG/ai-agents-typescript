{
  "name": "ai-agents-core",
  "version": "1.0.0",
  "type": "module",
  "description": "Core para creación de agentes de IA con TypeScript y Groq",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "dev": "tsc && tsc-alias && node dist/index.js",
    "evals": "tsc && tsc-alias && node dist/evals/cli.js",
    "lint": "biome check src __tests__",
    "lint:fix": "biome check --write --unsafe src __tests__",
    "format": "biome format --write src __tests__",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^25.9.0",
    "tsc-alias": "^1.2.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.6"
  }
}
